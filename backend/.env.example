# Copy to .env and adjust as needed. Defaults below work out of the box
# against `docker compose up -d` (see docker-compose.yml).

# Async DSN used by the running app (SQLAlchemy asyncpg driver).
DATABASE_URL=postgresql+asyncpg://reconcile:reconcile@localhost:5432/reconcile_dev

# Sync DSN used only by Alembic migrations (psycopg driver).
DATABASE_URL_SYNC=postgresql+psycopg://reconcile:reconcile@localhost:5432/reconcile_dev

REDIS_URL=redis://localhost:6379/0

JWT_SECRET=change-me-in-.env
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

STORAGE_DIR=./storage/uploads

# Comma-separated origins the browser SPA is served from (CORS).
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
